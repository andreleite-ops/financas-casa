# Copie para .streamlit/secrets.toml e preencha.
# NUNCA comite o secrets.toml — ele está no .gitignore.
# No Streamlit Cloud, cole este mesmo conteúdo em Settings > Secrets.

# --- Base única na nuvem (Supabase) ---------------------------------------
# Supabase > Project Settings > Database > Connection string > URI
# Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL = "postgresql://postgres.SEUPROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Classificação por IA e análise mensal (opcional) ---------------------
# console.anthropic.com > API Keys. Sem esta chave o sistema funciona só com
# regras + classificação manual.
ANTHROPIC_API_KEY = "sk-ant-..."

# --- Os dois usuários -----------------------------------------------------
# Gere os hashes com:  python scripts/gerar_senha.py
[usuarios.andre]
nome = "André"
senha_hash = "$2b$12$COLE_AQUI_O_HASH_DO_ANDRE"

[usuarios.ro]
nome = "Rô"
senha_hash = "$2b$12$COLE_AQUI_O_HASH_DA_RO"

# --- Alternativa: campos separados -----------------------------------------
# Use no lugar do DATABASE_URL quando a senha do banco tiver @, #, / ou :
# Assim a senha vai crua, sem precisar escapar nada.
# DB_HOST = "aws-0-sa-east-1.pooler.supabase.com"
# DB_USER = "postgres.SEUPROJETO"
# DB_PASSWORD = "sua senha do banco, como veio do Supabase"
# DB_PORT = "5432"
# DB_NAME = "postgres"
